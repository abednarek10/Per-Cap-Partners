# Public canonical origin used for canonical URLs, sitemap, JSON-LD and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.percappartners.com

# Postgres connection string for lead storage (Supabase/Neon). Required in production.
# Without it, local dev writes leads to .data/leads.jsonl.
DATABASE_URL=

# Secret used to hash client IPs for rate limiting (any long random string).
LEAD_IP_SALT=
