# Public canonical origin used for canonical URLs, sitemap, JSON-LD and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.percappartners.com

# Postgres. The app connects as the restricted role (row-level security always applies);
# migrations run as the schema owner. See db/migrations and scripts/migrate.mjs.
DATABASE_URL=postgres://percap_app:CHANGE_ME@localhost:5432/percap_dev
DATABASE_OWNER_URL=postgres://percap_owner:CHANGE_ME@localhost:5432/percap_dev

# Secret used to hash client IPs for rate limiting (any long random string).
LEAD_IP_SALT=

# Step 2 (auth): long random secret and the app's base URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
